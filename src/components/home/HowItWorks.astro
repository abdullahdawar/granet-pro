---
// How It Works section
---

<section id="how-it-works" class="bg-dark text-dark-foreground py-24" data-ps="src/components/home/HowItWorks.astro:hiw-01">
  <div class="max-w-7xl mx-auto px-6" data-ps="src/components/home/HowItWorks.astro:hiw-02">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal" data-ps="src/components/home/HowItWorks.astro:hiw-03">
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-dark-foreground" data-ps="src/components/home/HowItWorks.astro:hiw-04">Three steps to full autonomy.</h2>
      <p class="text-xl text-dark-muted" data-ps="src/components/home/HowItWorks.astro:hiw-05">Getting started with SyncFlow is fast, intuitive, and requires zero technical background.</p>
    </div>

    <!-- Step 1 -->
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-24 mb-32" data-ps="src/components/home/HowItWorks.astro:hiw-06">
      <div class="md:w-1/2 reveal-left" data-ps="src/components/home/HowItWorks.astro:hiw-07">
        <span class="text-dark-foreground font-bold text-lg mb-4 block" data-ps="src/components/home/HowItWorks.astro:hiw-08">Step 01</span>
        <h3 class="text-3xl md:text-4xl font-bold mb-6" data-ps="src/components/home/HowItWorks.astro:hiw-09">Connect your apps</h3>
        <p class="text-xl text-dark-muted mb-8" data-ps="src/components/home/HowItWorks.astro:hiw-10">Choose from over 500+ pre-built integrations. Simply authenticate your accounts and SyncFlow handles the data mapping automatically.</p>
        <ul class="space-y-4" data-ps="src/components/home/HowItWorks.astro:hiw-11">
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2j"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> 500+ Native Integrations</li>
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2k"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> OAuth 2.0 Secure Auth</li>
        </ul>
      </div>
      <div class="md:w-1/2 reveal-right" data-ps="src/components/home/HowItWorks.astro:hiw-12">
        <img
          src="https://images.pexels.com/photos/16592498/pexels-photo-16592498.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Secure API Connections"
          class="rounded-2xl shadow-2xl w-full h-[400px] object-cover"
          loading="lazy" data-ps="src/components/home/HowItWorks.astro:bvphw5" />
      </div>
    </div>

    <!-- Step 2 -->
    <div class="flex flex-col md:flex-row-reverse items-center gap-12 md:gap-24 mb-32" data-ps="src/components/home/HowItWorks.astro:hiw-13">
      <div class="md:w-1/2 reveal-right" data-ps="src/components/home/HowItWorks.astro:hiw-14">
        <span class="text-dark-foreground font-bold text-lg mb-4 block" data-ps="src/components/home/HowItWorks.astro:hiw-15">Step 02</span>
        <h3 class="text-3xl md:text-4xl font-bold mb-6" data-ps="src/components/home/HowItWorks.astro:hiw-16">Build your workflow</h3>
        <p class="text-xl text-dark-muted mb-8" data-ps="src/components/home/HowItWorks.astro:hiw-17">Use our visual drag-and-drop builder to define triggers and actions. Add filters, logic splits, and data transformations with ease.</p>
        <ul class="space-y-4" data-ps="src/components/home/HowItWorks.astro:hiw-18">
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2l"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> Visual Canvas Editor</li>
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2m"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> Conditional Logic Engine</li>
        </ul>
      </div>
      <div class="md:w-1/2 reveal-left" data-ps="src/components/home/HowItWorks.astro:hiw-19">
        <img
          src="https://images.pexels.com/photos/6937932/pexels-photo-6937932.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Workflow Builder Interface"
          class="rounded-2xl shadow-2xl w-full h-[400px] object-cover"
          loading="lazy" data-ps="src/components/home/HowItWorks.astro:bvphw6" />
      </div>
    </div>

    <!-- Step 3 -->
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-24" data-ps="src/components/home/HowItWorks.astro:hiw-20">
      <div class="md:w-1/2 reveal-left" data-ps="src/components/home/HowItWorks.astro:hiw-21">
        <span class="text-dark-foreground font-bold text-lg mb-4 block" data-ps="src/components/home/HowItWorks.astro:hiw-22">Step 03</span>
        <h3 class="text-3xl md:text-4xl font-bold mb-6" data-ps="src/components/home/HowItWorks.astro:hiw-23">Put it on autopilot</h3>
        <p class="text-xl text-dark-muted mb-8" data-ps="src/components/home/HowItWorks.astro:hiw-24">Switch it on and let it run. Monitor performance from your dashboard and get notified if anything needs your attention.</p>
        <ul class="space-y-4" data-ps="src/components/home/HowItWorks.astro:hiw-25">
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2n"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> 24/7 Monitoring</li>
          <li class="flex items-center gap-3 text-dark-muted" data-ps="src/components/home/HowItWorks.astro:7t1e2o"><svg class="w-5 h-5 text-dark-foreground" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> Error Auto-Recovery</li>
        </ul>
      </div>
      <div class="md:w-1/2 reveal-right" data-ps="src/components/home/HowItWorks.astro:hiw-26">
        <img
          src="https://images.pexels.com/photos/7172854/pexels-photo-7172854.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Successful Automation Metrics"
          class="rounded-2xl shadow-2xl w-full h-[400px] object-cover"
          loading="lazy" data-ps="src/components/home/HowItWorks.astro:bvphw7" />
      </div>
    </div>
  </div>
</section>
