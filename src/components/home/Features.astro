---
// Features section
---

<section id="features" class="bg-background py-24 px-6" data-ps="src/components/home/Features.astro:feat-01">
  <div class="max-w-7xl mx-auto" data-ps="src/components/home/Features.astro:feat-02">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal" data-ps="src/components/home/Features.astro:feat-03">
      <h2 class="text-3xl md:text-5xl font-bold mb-6" data-ps="src/components/home/Features.astro:feat-04">Everything you need to scale faster.</h2>
      <p class="text-xl text-muted-foreground" data-ps="src/components/home/Features.astro:feat-05">SyncFlow is built for teams that want to eliminate manual data entry and focus on what truly drives growth.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-ps="src/components/home/Features.astro:feat-06">
      <!-- Card 1 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-07">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-08">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-09">Real-time Sync</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-10">Instant data synchronization across all your connected applications without the lag.</p>
      </div>

      <!-- Card 2 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal reveal-delay-1 hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-11">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-12">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-13">Visual Builder</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-14">Drag-and-drop workflow designer. No coding required to automate complex logic.</p>
      </div>

      <!-- Card 3 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal reveal-delay-2 hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-15">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-16">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04kM12 21.48l.342.124a11.955 11.955 0 01-8.96-8.96L12 3.52l.342-.124a11.955 11.955 0 018.96 8.96l-8.96 8.96z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-17">Enterprise Security</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-18">Bank-grade encryption and SOC2 compliance to keep your sensitive data protected.</p>
      </div>

      <!-- Card 4 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal reveal-delay-3 hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-19">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-20">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-21">Custom Webhooks</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-22">Connect legacy software or custom apps with our powerful webhook integration system.</p>
      </div>

      <!-- Card 5 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal reveal-delay-4 hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-23">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-24">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-25">Team Collaboration</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-26">Shared workspaces allow your entire team to build and manage workflows together.</p>
      </div>

      <!-- Card 6 -->
      <div class="bg-background p-8 rounded-2xl border border-border shadow-sm hover:shadow-md transition-all reveal reveal-delay-5 hover:-translate-y-1" data-ps="src/components/home/Features.astro:feat-27">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6" data-ps="src/components/home/Features.astro:feat-28">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3" data-ps="src/components/home/Features.astro:feat-29">Advanced Analytics</h3>
        <p class="text-muted-foreground" data-ps="src/components/home/Features.astro:feat-30">Detailed reporting on workflow efficiency and time-saved metrics for your business.</p>
      </div>
    </div>
  </div>
</section>
