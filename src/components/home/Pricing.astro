---
// Pricing section
---

<section id="pricing" class="bg-surface py-24" data-ps="src/components/home/Pricing.astro:pr-01">
  <div class="max-w-7xl mx-auto px-6" data-ps="src/components/home/Pricing.astro:pr-02">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal" data-ps="src/components/home/Pricing.astro:pr-03">
      <h2 class="text-3xl md:text-5xl font-bold mb-6" data-ps="src/components/home/Pricing.astro:pr-04">Plans for every stage of growth.</h2>
      <p class="text-xl text-muted-foreground" data-ps="src/components/home/Pricing.astro:pr-05">Start for free and scale as you grow. All plans include 256-bit SSL encryption.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/Pricing.astro:pr-06">
      <!-- Starter -->
      <div class="bg-background p-10 rounded-2xl border border-border flex flex-col reveal" data-ps="src/components/home/Pricing.astro:pr-07">
        <div class="mb-8" data-ps="src/components/home/Pricing.astro:pr-08">
          <h3 class="text-lg font-bold text-muted-foreground uppercase tracking-widest mb-4" data-ps="src/components/home/Pricing.astro:b8x2xq">Starter</h3>
          <div class="flex items-baseline gap-1" data-ps="src/components/home/Pricing.astro:xj797n">
            <span class="text-4xl font-bold" data-ps="src/components/home/Pricing.astro:3fe82g">$15</span>
            <span class="text-muted-foreground" data-ps="src/components/home/Pricing.astro:3fe82f">/mo</span>
          </div>
        </div>
        <ul class="space-y-4 mb-10 flex-grow" data-ps="src/components/home/Pricing.astro:pr-09">
          <li class="flex items-center gap-3" data-ps="src/components/home/Pricing.astro:lwgkme"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 1,000 Operations / mo</li>
          <li class="flex items-center gap-3" data-ps="src/components/home/Pricing.astro:lwgkmf"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 10 Workflows</li>
          <li class="flex items-center gap-3 text-muted-foreground/50" data-ps="src/components/home/Pricing.astro:lwgkmg"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg> Advanced Logic</li>
        </ul>
        <a href="#cta" class="w-full py-4 text-center border border-border rounded-md font-bold hover:bg-surface transition-colors" data-ps="src/components/home/Pricing.astro:7ln06l">Choose Starter</a>
      </div>

      <!-- Pro -->
      <div class="bg-background p-10 rounded-2xl border-2 border-primary shadow-xl flex flex-col relative reveal reveal-scale" data-ps="src/components/home/Pricing.astro:pr-10">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-primary-foreground px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest" data-ps="src/components/home/Pricing.astro:xj797m">Most Popular</div>
        <div class="mb-8" data-ps="src/components/home/Pricing.astro:pr-11">
          <h3 class="text-lg font-bold text-primary uppercase tracking-widest mb-4" data-ps="src/components/home/Pricing.astro:b8x2xp">Pro</h3>
          <div class="flex items-baseline gap-1" data-ps="src/components/home/Pricing.astro:xj797l">
            <span class="text-4xl font-bold" data-ps="src/components/home/Pricing.astro:3zapt">$49</span>
            <span class="text-muted-foreground" data-ps="src/components/home/Pricing.astro:3zaps">/mo</span>
          </div>
        </div>
        <ul class="space-y-4 mb-10 flex-grow" data-ps="src/components/home/Pricing.astro:pr-12">
          <li class="flex items-center gap-3 font-semibold" data-ps="src/components/home/Pricing.astro:lwgkmh"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 10,000 Operations / mo</li>
          <li class="flex items-center gap-3 font-semibold" data-ps="src/components/home/Pricing.astro:lwgkmi"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Unlimited Workflows</li>
          <li class="flex items-center gap-3 font-semibold" data-ps="src/components/home/Pricing.astro:lwgkn4"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Advanced Logic & Filters</li>
          <li class="flex items-center gap-3 font-semibold" data-ps="src/components/home/Pricing.astro:lwgkn5"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Priority Email Support</li>
        </ul>
        <a href="#cta" class="w-full py-4 text-center bg-primary text-primary-foreground rounded-md font-bold hover:bg-primary-hover shadow-lg transition-all" data-ps="src/components/home/Pricing.astro:7ln06m">Get Started with Pro</a>
      </div>

      <!-- Enterprise -->
      <div class="bg-background p-10 rounded-2xl border border-border flex flex-col reveal" data-ps="src/components/home/Pricing.astro:pr-13">
        <div class="mb-8" data-ps="src/components/home/Pricing.astro:pr-14">
          <h3 class="text-lg font-bold text-muted-foreground uppercase tracking-widest mb-4" data-ps="src/components/home/Pricing.astro:b8x2xo">Enterprise</h3>
          <div class="flex items-baseline gap-1" data-ps="src/components/home/Pricing.astro:xj797k">
            <span class="text-4xl font-bold" data-ps="src/components/home/Pricing.astro:3zapr">Custom</span>
          </div>
        </div>
        <ul class="space-y-4 mb-10 flex-grow" data-ps="src/components/home/Pricing.astro:pr-15">
          <li class="flex items-center gap-3" data-ps="src/components/home/Pricing.astro:lwgkn6"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Unlimited Everything</li>
          <li class="flex items-center gap-3" data-ps="src/components/home/Pricing.astro:lwgkn7"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Custom SLA & Security</li>
          <li class="flex items-center gap-3" data-ps="src/components/home/Pricing.astro:lwgkn8"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Dedicated Account Manager</li>
        </ul>
        <a href="#cta" class="w-full py-4 text-center border border-border rounded-md font-bold hover:bg-surface transition-colors" data-ps="src/components/home/Pricing.astro:7ln06n">Contact Sales</a>
      </div>
    </div>
  </div>
</section>
