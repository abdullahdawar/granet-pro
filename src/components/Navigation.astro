---
import { SITE } from '@/config/site';

export interface Props {
  logo?: string;
}

const { logo = SITE.name } = Astro.props;
---

<header id="navbar" class="sticky top-0 z-50 bg-background backdrop-blur-lg border-b border-border" data-ps="src/components/Navigation.astro:nav-01">
  <nav class="py-4" data-ps="src/components/Navigation.astro:nav-02">
    <div class="max-w-7xl mx-auto px-6 flex justify-between items-center" data-ps="src/components/Navigation.astro:nav-03">
      <a href="/" class="text-2xl font-bold text-primary no-underline hover:text-primary-hover transition-all flex items-center gap-2" data-ps="src/components/Navigation.astro:nav-04">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 16L12 20L20 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 12L12 16L20 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 4L4 8L12 12L20 8L12 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-ps="src/components/Navigation.astro:i2om6f">{logo}</span>
      </a>

      <div class="flex items-center gap-8 ml-auto" data-ps="src/components/Navigation.astro:nav-05">
        <div class="hidden md:flex gap-8 items-center" data-ps="src/components/Navigation.astro:nav-06">
          <a href="/#features" class="text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors" data-ps="src/components/Navigation.astro:nav-07">Features</a>
          <a href="/#how-it-works" class="text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors" data-ps="src/components/Navigation.astro:nav-08">How It Works</a>
          <a href="/#pricing" class="text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors" data-ps="src/components/Navigation.astro:nav-09">Pricing</a>
        </div>

        <div class="hidden md:flex items-center gap-4" data-ps="src/components/Navigation.astro:gqvsdd">
          <a href="/#login" class="text-sm font-semibold text-foreground hover:text-primary transition-colors" data-ps="src/components/Navigation.astro:7vkjsf">Log in</a>
          <a href="/#cta" class="bg-primary text-primary-foreground px-5 py-2.5 rounded-md text-sm font-bold hover:bg-primary-hover transition-all shadow-sm hover:shadow-md" data-ps="src/components/Navigation.astro:kd8n5z">
            Get Started
          </a>
        </div>

        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 text-foreground hover:text-primary transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
         data-ps="src/components/Navigation.astro:nav-10">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden md:hidden overflow-hidden bg-background border-t border-border"
    role="navigation"
    aria-label="Mobile navigation"
   data-ps="src/components/Navigation.astro:nav-11">
    <nav class="flex flex-col py-6 px-6 gap-4 text-center" data-ps="src/components/Navigation.astro:m59h38">
      <a href="/#features" class="text-lg font-semibold text-muted-foreground py-2 hover:text-primary transition-colors" data-ps="src/components/Navigation.astro:kd8n5y">Features</a>
      <a href="/#how-it-works" class="text-lg font-semibold text-muted-foreground py-2 hover:text-primary transition-colors" data-ps="src/components/Navigation.astro:kd8n5x">How It Works</a>
      <a href="/#pricing" class="text-lg font-semibold text-muted-foreground py-2 hover:text-primary transition-colors" data-ps="src/components/Navigation.astro:kd8n5w">Pricing</a>
      <div class="pt-4 border-t border-border flex flex-col gap-4" data-ps="src/components/Navigation.astro:gqvsde">
        <a href="/#login" class="text-lg font-semibold text-foreground py-2" data-ps="src/components/Navigation.astro:kd8n5v">Log in</a>
        <a href="/#cta" class="bg-primary text-primary-foreground px-6 py-3 rounded-md text-lg font-bold" data-ps="src/components/Navigation.astro:kd8n5u">
          Get Started
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const navbar = document.getElementById('navbar');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function updateNavbar() {
    if (window.scrollY > 20) {
      navbar?.classList.add('md:bg-background/90');
      navbar?.classList.add('shadow-sm');
    } else {
      navbar?.classList.remove('md:bg-background/90');
      navbar?.classList.remove('shadow-sm');
    }
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
