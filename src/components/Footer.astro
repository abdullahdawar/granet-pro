---
// Footer component
import { SITE } from '@/config/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-dark-foreground py-20 border-t border-dark-border" data-ps="src/components/Footer.astro:ft-01">
  <div class="max-w-7xl mx-auto px-6" data-ps="src/components/Footer.astro:ft-02">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16" data-ps="src/components/Footer.astro:ft-03">
      <!-- Brand Column -->
      <div class="md:col-span-1" data-ps="src/components/Footer.astro:ft-04">
        <a href="/" class="text-2xl font-bold text-dark-foreground mb-6 inline-block" data-ps="src/components/Footer.astro:ft-05">
          {SITE.name}
        </a>
        <p class="text-dark-muted mb-8" data-ps="src/components/Footer.astro:ft-06">
          Automating the world's workflows so teams can focus on growth.
        </p>
        <div class="flex gap-4" data-ps="src/components/Footer.astro:ft-07">
          <a href="#" class="text-dark-muted hover:text-dark-foreground transition-colors" aria-label="Twitter" data-ps="src/components/Footer.astro:7gqc0g">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </a>
          <a href="#" class="text-dark-muted hover:text-dark-foreground transition-colors" aria-label="LinkedIn" data-ps="src/components/Footer.astro:7gqc0h">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

      <!-- Links Columns -->
      <div data-ps="src/components/Footer.astro:ft-08">
        <h4 class="font-bold mb-6 text-dark-foreground" data-ps="src/components/Footer.astro:fy3jb3">Product</h4>
        <ul class="space-y-4 text-dark-muted">
          <li data-ps="src/components/Footer.astro:wyji6g"><a href="#features" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:7gqc0i">Features</a></li>
          <li data-ps="src/components/Footer.astro:wyji6h"><a href="#how-it-works" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:7gqc0j">Integrations</a></li>
          <li data-ps="src/components/Footer.astro:wyji6i"><a href="#pricing" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:7gqc0k">Pricing</a></li>
          <li data-ps="src/components/Footer.astro:wyji6j"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:7gqc0l">API Docs</a></li>
        </ul>
      </div>

      <div data-ps="src/components/Footer.astro:ft-09">
        <h4 class="font-bold mb-6 text-dark-foreground" data-ps="src/components/Footer.astro:fy3jb2">Company</h4>
        <ul class="space-y-4 text-dark-muted">
          <li data-ps="src/components/Footer.astro:wyji6k"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:7gqc0m">About Us</a></li>
          <li data-ps="src/components/Footer.astro:wyji6l"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2pe">Careers</a></li>
          <li data-ps="src/components/Footer.astro:wyji6m"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2pf">Blog</a></li>
          <li data-ps="src/components/Footer.astro:wyji6n"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2pg">Contact</a></li>
        </ul>
      </div>

      <div data-ps="src/components/Footer.astro:ft-10">
        <h4 class="font-bold mb-6 text-dark-foreground" data-ps="src/components/Footer.astro:fy3jb1">Legal</h4>
        <ul class="space-y-4 text-dark-muted">
          <li data-ps="src/components/Footer.astro:wyji79"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2ph">Privacy Policy</a></li>
          <li data-ps="src/components/Footer.astro:wyji7a"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2pi">Terms of Service</a></li>
          <li data-ps="src/components/Footer.astro:wyji7b"><a href="#" class="hover:text-dark-foreground transition-colors" data-ps="src/components/Footer.astro:8o2pj">Cookie Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-dark-border text-center text-dark-muted text-sm" data-ps="src/components/Footer.astro:ft-11">
      <p data-ps="src/components/Footer.astro:euoq">&copy; {currentYear} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
